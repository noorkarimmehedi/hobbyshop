<script>
(function() {
  'use strict';
  
  // Price mapping for different packages
  const PACKAGE_PRICES = {
    '1': { price: 890, variantId: null }, // Replace with your actual variant IDs
    '2': { price: 1280, variantId: null },
    '3': { price: 1650, variantId: null }
  };

  function updateOilSelectors() {
    const packageType = document.getElementById('package-type').value;
    const oilSelections = document.getElementById('oil-selections');
    const oil2Container = document.getElementById('oil2-container');
    const oil3Container = document.getElementById('oil3-container');
    const addToCartBtn = document.getElementById('add-customized-to-cart');
    const priceDisplay = document.getElementById('price-display');
    const priceText = priceDisplay.querySelector('p');
    const errorMessage = document.getElementById('error-message');
    
    // Reset error message
    errorMessage.style.display = 'none';
    
    // Hide all initially
    oil2Container.style.display = 'none';
    oil3Container.style.display = 'none';
    document.getElementById('oil2').value = '';
    document.getElementById('oil3').value = '';
    
    if (packageType === '') {
      oilSelections.style.display = 'none';
      priceDisplay.style.display = 'none';
      addToCartBtn.disabled = true;
      return;
    }
    
    oilSelections.style.display = 'block';
    priceDisplay.style.display = 'block';
    
    // Show appropriate selectors based on package type
    if (packageType === '2') {
      oil2Container.style.display = 'block';
      priceText.textContent = 'মোট মূল্য: ৳' + PACKAGE_PRICES['2'].price;
    } else if (packageType === '3') {
      oil2Container.style.display = 'block';
      oil3Container.style.display = 'block';
      priceText.textContent = 'মোট মূল্য: ৳' + PACKAGE_PRICES['3'].price;
    } else {
      priceText.textContent = 'মোট মূল্য: ৳' + PACKAGE_PRICES['1'].price;
    }
    
    validateSelections();
  }

  function validateSelections() {
    const packageType = document.getElementById('package-type').value;
    const oil1 = document.getElementById('oil1').value;
    const oil2 = document.getElementById('oil2').value;
    const oil3 = document.getElementById('oil3').value;
    const addToCartBtn = document.getElementById('add-customized-to-cart');
    const errorMessage = document.getElementById('error-message');
    
    let isValid = false;
    errorMessage.style.display = 'none';
    
    if (packageType === '1' && oil1) {
      isValid = true;
    } else if (packageType === '2' && oil1 && oil2) {
      // Check for duplicates
      if (oil1 === oil2) {
        errorMessage.textContent = 'দয়া করে ভিন্ন অয়েল নির্বাচন করুন';
        errorMessage.style.display = 'block';
        isValid = false;
      } else {
        isValid = true;
      }
    } else if (packageType === '3' && oil1 && oil2 && oil3) {
      // Check for duplicates
      if (oil1 === oil2 || oil1 === oil3 || oil2 === oil3) {
        errorMessage.textContent = 'দয়া করে ভিন্ন অয়েল নির্বাচন করুন';
        errorMessage.style.display = 'block';
        isValid = false;
      } else {
        isValid = true;
      }
    }
    
    addToCartBtn.disabled = !isValid;
  }

  function addToCart() {
    const packageType = document.getElementById('package-type').value;
    const oil1Select = document.getElementById('oil1');
    const oil2Select = document.getElementById('oil2');
    const oil3Select = document.getElementById('oil3');
    const addToCartBtn = document.getElementById('add-customized-to-cart');
    const errorMessage = document.getElementById('error-message');
    
    // Get selected oil names
    const oil1 = oil1Select.options[oil1Select.selectedIndex].text;
    const oil2 = oil2Select.value ? oil2Select.options[oil2Select.selectedIndex].text : '';
    const oil3 = oil3Select.value ? oil3Select.options[oil3Select.selectedIndex].text : '';
    
    // Build properties object
    let properties = {
      'Package Type': packageType === '1' ? 'Single Oil' : packageType === '2' ? 'Double Oil' : 'Triple Oil',
      'Oil 1': oil1
    };
    
    if (packageType === '2' || packageType === '3') {
      properties['Oil 2'] = oil2;
    }
    if (packageType === '3') {
      properties['Oil 3'] = oil3;
    }
    
    // Disable button and show loading
    addToCartBtn.disabled = true;
    addToCartBtn.textContent = 'যুক্ত হচ্ছে...';
    
    // Get the main product variant ID (you'll need to set this)
    const variantId = {{ product.selected_or_first_available_variant.id }};
    
    let formData = {
      items: [{
        id: variantId,
        quantity: 1,
        properties: properties
      }]
    };
    
    fetch('/cart/add.js', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify(formData)
    })
    .then(response => response.json())
    .then(data => {
      // Success - redirect to cart or show notification
      window.location.href = '/cart';
    })
    .catch(error => {
      console.error('Error:', error);
      errorMessage.textContent = 'কার্টে যোগ করতে সমস্যা হয়েছে। আবার চেষ্টা করুন।';
      errorMessage.style.display = 'block';
      addToCartBtn.disabled = false;
      addToCartBtn.textContent = 'কার্টে যোগ করুন';
    });
  }

  // Initialize event listeners when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

  function init() {
    // Add change listeners to all selects
    document.getElementById('package-type').addEventListener('change', updateOilSelectors);
    document.getElementById('oil1').addEventListener('change', validateSelections);
    document.getElementById('oil2').addEventListener('change', validateSelections);
    document.getElementById('oil3').addEventListener('change', validateSelections);
    
    // Add click listener to add to cart button
    document.getElementById('add-customized-to-cart').addEventListener('click', addToCart);
  }

  // Expose function to global scope for inline onclick
  window.updateOilSelectors = updateOilSelectors;
})();
</script>

