{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-category-slider-{{ ai_gen_id }} {
    width: 100%;
    overflow: hidden;
    position: relative;
  }

  .ai-category-slider__container-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.gap }}px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 10px 0;
  }

  .ai-category-slider__container-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-category-slider__item-{{ ai_gen_id }} {
    flex: 0 0 calc((100% - ({{ block.settings.gap }}px * ({{ block.settings.columns_mobile }} - 1))) / {{ block.settings.columns_mobile }});
    min-width: calc((100% - ({{ block.settings.gap }}px * ({{ block.settings.columns_mobile }} - 1))) / {{ block.settings.columns_mobile }});
  }

  @media screen and (min-width: 750px) {
    .ai-category-slider__item-{{ ai_gen_id }} {
      flex: 0 0 calc((100% - ({{ block.settings.gap }}px * ({{ block.settings.columns_desktop }} - 1))) / {{ block.settings.columns_desktop }});
      min-width: calc((100% - ({{ block.settings.gap }}px * ({{ block.settings.columns_desktop }} - 1))) / {{ block.settings.columns_desktop }});
    }
  }

  .ai-category-card-{{ ai_gen_id }} {
    position: relative;
    display: block;
    text-decoration: none;
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    transition: all 0.3s ease;
    {% if block.settings.shadow_opacity > 0 %}
      box-shadow: {{ block.settings.shadow_horizontal }}px {{ block.settings.shadow_vertical }}px {{ block.settings.shadow_blur }}px rgba(0, 0, 0, {{ block.settings.shadow_opacity | divided_by: 100.0 }});
    {% endif %}
  }

  .ai-category-card-{{ ai_gen_id }}:hover {
    border-color: {{ block.settings.hover_border_color }};
  }

  .ai-category-card__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: {{ block.settings.image_aspect_ratio }}%;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-category-card__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-category-card__placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-category-card__placeholder-{{ ai_gen_id }} svg {
    width: 50%;
    height: 50%;
    opacity: 0.3;
  }

  .ai-category-card__title-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: {{ block.settings.overlay_color }};
    color: {{ block.settings.overlay_text_color }};
    font-size: {{ block.settings.title_size }}px;
    font-weight: {{ block.settings.title_weight }};
    text-align: center;
    padding: 15px;
  }

  .ai-category-card__title-below-{{ ai_gen_id }} {
    padding: {{ block.settings.text_padding }}px;
    background-color: {{ block.settings.text_bg_color }};
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.title_size }}px;
    font-weight: {{ block.settings.title_weight }};
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-category-slider__nav-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 20px;
  }

  .ai-category-slider__nav-button-{{ ai_gen_id }} {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 2px solid {{ block.settings.nav_color }};
    background-color: {{ block.settings.nav_bg_color }};
    color: {{ block.settings.nav_color }};
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .ai-category-slider__nav-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.nav_color }};
    color: {{ block.settings.nav_bg_color }};
  }

  .ai-category-slider__nav-button-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-category-slider__nav-button-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
  }
{% endstyle %}

<category-slider-{{ ai_gen_id }} class="ai-category-slider-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-category-slider__container-{{ ai_gen_id }}" data-slider-container>
    {% for i in (1..12) %}
      {% assign collection_key = 'collection_' | append: i %}
      {% assign collection = block.settings[collection_key] %}
      
      {% if collection != blank %}
        <div class="ai-category-slider__item-{{ ai_gen_id }}">
          <a href="{{ collection.url }}" class="ai-category-card-{{ ai_gen_id }}">
            <div class="ai-category-card__image-wrapper-{{ ai_gen_id }}">
              {% if collection.featured_image %}
                <img
                  src="{{ collection.featured_image | image_url: width: 600 }}"
                  alt="{{ collection.title | escape }}"
                  class="ai-category-card__image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="600"
                  height="{{ 600 | times: block.settings.image_aspect_ratio | divided_by: 100 }}"
                >
              {% else %}
                <div class="ai-category-card__placeholder-{{ ai_gen_id }}">
                  {{ 'collection-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
              
              {% if block.settings.title_position == 'overlay' %}
                <div class="ai-category-card__title-overlay-{{ ai_gen_id }}">
                  {{ collection.title }}
                </div>
              {% endif %}
            </div>
            
            {% if block.settings.title_position == 'below' %}
              <div class="ai-category-card__title-below-{{ ai_gen_id }}">
                {{ collection.title }}
              </div>
            {% endif %}
          </a>
        </div>
      {% endif %}
    {% endfor %}
  </div>

  {% if block.settings.show_navigation %}
    <div class="ai-category-slider__nav-{{ ai_gen_id }}">
      <button
        class="ai-category-slider__nav-button-{{ ai_gen_id }}"
        data-nav-prev
        aria-label="Previous"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>
      <button
        class="ai-category-slider__nav-button-{{ ai_gen_id }}"
        data-nav-next
        aria-label="Next"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>
  {% endif %}
</category-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class CategorySlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.container = this.querySelector('[data-slider-container]');
        this.prevButton = this.querySelector('[data-nav-prev]');
        this.nextButton = this.querySelector('[data-nav-next]');
      }

      connectedCallback() {
        if (this.prevButton && this.nextButton) {
          this.setupNavigation();
        }
      }

      setupNavigation() {
        this.prevButton.addEventListener('click', () => this.scroll('prev'));
        this.nextButton.addEventListener('click', () => this.scroll('next'));
        this.container.addEventListener('scroll', () => this.updateButtons());
        this.updateButtons();
      }

      scroll(direction) {
        const scrollAmount = this.container.offsetWidth * 0.8;
        const scrollLeft = direction === 'prev' 
          ? this.container.scrollLeft - scrollAmount 
          : this.container.scrollLeft + scrollAmount;
        
        this.container.scrollTo({
          left: scrollLeft,
          behavior: 'smooth'
        });
      }

      updateButtons() {
        const isAtStart = this.container.scrollLeft <= 0;
        const isAtEnd = this.container.scrollLeft + this.container.offsetWidth >= this.container.scrollWidth - 1;
        
        this.prevButton.disabled = isAtStart;
        this.nextButton.disabled = isAtEnd;
      }
    }

    customElements.define('category-slider-{{ ai_gen_id }}', CategorySlider{{ ai_gen_id }});
  })();
</script>

