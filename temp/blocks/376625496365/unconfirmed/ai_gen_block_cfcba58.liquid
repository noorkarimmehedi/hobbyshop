{% doc %}
  @prompt
    generate me a category slider for me  , it's good but i want something like category size can be customizable can be option for squared shape or circle shape, i want at least 20 collections , option to add collections image , i can customise the section background color it's not working. also need option to add collections border color 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-category-slider-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding }}px 0;
    background-color: {{ block.settings.background_color }};
  }

  .ai-category-slider__container-{{ ai_gen_id }} {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-category-slider__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: 40px;
  }

  .ai-category-slider__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 12px;
    font-weight: 700;
  }

  .ai-category-slider__subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-category-slider__wrapper-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-category-slider__track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.card_gap }}px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 10px 0;
  }

  .ai-category-slider__track-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-category-slider__card-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.category_size }}px;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    background-color: {{ block.settings.card_background }};
    border-radius: {% if block.settings.category_shape == 'circle' %}50%{% else %}{{ block.settings.card_border_radius }}px{% endif %};
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
  }

  .ai-category-slider__card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.15);
  }

  .ai-category-slider__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-category-slider__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-category-slider__image-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-category-slider__image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-category-slider__content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
    text-align: center;
    {% if block.settings.category_shape == 'circle' %}
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      background: linear-gradient(to top, rgba(0, 0, 0, 0.7), transparent);
      color: #ffffff;
    {% endif %}
  }

  .ai-category-slider__category-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.category_title_size }}px;
    color: {% if block.settings.category_shape == 'circle' %}#ffffff{% else %}{{ block.settings.card_text_color }}{% endif %};
    margin: 0 0 8px;
    font-weight: 600;
  }

  .ai-category-slider__category-count-{{ ai_gen_id }} {
    font-size: {{ block.settings.category_count_size }}px;
    color: {% if block.settings.category_shape == 'circle' %}#ffffff{% else %}{{ block.settings.card_text_color }}{% endif %};
    opacity: 0.9;
    margin: 0;
  }

  .ai-category-slider__nav-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
    background-color: {{ block.settings.nav_button_background }};
    color: {{ block.settings.nav_button_color }};
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    transition: background-color 0.3s ease, transform 0.2s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  .ai-category-slider__nav-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.nav_button_hover_background }};
    transform: translateY(-50%) scale(1.1);
  }

  .ai-category-slider__nav-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-category-slider__nav-{{ ai_gen_id }}:disabled:hover {
    transform: translateY(-50%) scale(1);
  }

  .ai-category-slider__nav--prev-{{ ai_gen_id }} {
    left: -24px;
  }

  .ai-category-slider__nav--next-{{ ai_gen_id }} {
    right: -24px;
  }

  .ai-category-slider__nav-{{ ai_gen_id }} svg {
    width: 24px;
    height: 24px;
  }

  @media screen and (max-width: 749px) {
    .ai-category-slider__card-{{ ai_gen_id }} {
      flex: 0 0 {{ block.settings.category_size | times: 0.7 }}px;
    }

    .ai-category-slider__nav-{{ ai_gen_id }} {
      display: none;
    }

    .ai-category-slider__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-category-slider__subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.85 }}px;
    }
  }
{% endstyle %}

<category-slider-{{ ai_gen_id }}
  class="ai-category-slider-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-category-slider__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.subheading != blank %}
      <div class="ai-category-slider__header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-category-slider__title-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.subheading != blank %}
          <p class="ai-category-slider__subtitle-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-category-slider__wrapper-{{ ai_gen_id }}">
      <button
        class="ai-category-slider__nav-{{ ai_gen_id }} ai-category-slider__nav--prev-{{ ai_gen_id }}"
        aria-label="Previous categories"
        data-direction="prev"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <div class="ai-category-slider__track-{{ ai_gen_id }}">
        {% for i in (1..20) %}
          {% liquid
            assign collection_key = 'collection_' | append: i
            assign custom_image_key = 'custom_image_' | append: i
            assign collection = block.settings[collection_key]
            assign custom_image = block.settings[custom_image_key]
          %}

          {% if collection != blank %}
            <a
              href="{{ collection.url }}"
              class="ai-category-slider__card-{{ ai_gen_id }}"
            >
              <div class="ai-category-slider__image-wrapper-{{ ai_gen_id }}">
                {% if custom_image %}
                  <img
                    src="{{ custom_image | image_url: width: 600 }}"
                    alt="{{ custom_image.alt | escape }}"
                    class="ai-category-slider__image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="600"
                    height="600"
                  >
                {% elsif collection.featured_image %}
                  <img
                    src="{{ collection.featured_image | image_url: width: 600 }}"
                    alt="{{ collection.featured_image.alt | escape }}"
                    class="ai-category-slider__image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="600"
                    height="600"
                  >
                {% else %}
                  <div class="ai-category-slider__image-placeholder-{{ ai_gen_id }}">
                    {{ 'collection-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
                <div class="ai-category-slider__content-{{ ai_gen_id }}">
                  <h3 class="ai-category-slider__category-title-{{ ai_gen_id }}">
                    {{ collection.title }}
                  </h3>
                  {% if block.settings.show_product_count %}
                    <p class="ai-category-slider__category-count-{{ ai_gen_id }}">
                      {{ collection.products_count }}
                      {% if collection.products_count == 1 %}
                        product
                      {% else %}
                        products
                      {% endif %}
                    </p>
                  {% endif %}
                </div>
              </div>
            </a>
          {% endif %}
        {% endfor %}
      </div>

      <button
        class="ai-category-slider__nav-{{ ai_gen_id }} ai-category-slider__nav--next-{{ ai_gen_id }}"
        aria-label="Next categories"
        data-direction="next"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>
  </div>
</category-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class CategorySlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.track = this.querySelector('.ai-category-slider__track-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-category-slider__nav--prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-category-slider__nav--next-{{ ai_gen_id }}');
      }

      connectedCallback() {
        this.setupNavigation();
        this.updateButtonStates();
        this.track.addEventListener('scroll', () => this.updateButtonStates());
      }

      setupNavigation() {
        this.prevButton.addEventListener('click', () => this.scroll('prev'));
        this.nextButton.addEventListener('click', () => this.scroll('next'));
      }

      scroll(direction) {
        const categorySize = {{ block.settings.category_size }};
        const gap = {{ block.settings.card_gap }};
        const scrollAmount = (categorySize + gap) * 2;

        if (direction === 'prev') {
          this.track.scrollLeft -= scrollAmount;
        } else {
          this.track.scrollLeft += scrollAmount;
        }
      }

      updateButtonStates() {
        const isAtStart = this.track.scrollLeft <= 0;
        const isAtEnd = this.track.scrollLeft + this.track.clientWidth >= this.track.scrollWidth - 1;

        this.prevButton.disabled = isAtStart;
        this.nextButton.disabled = isAtEnd;
      }
    }

    customElements.define('category-slider-{{ ai_gen_id }}', CategorySlider{{ ai_gen_id }});
  })();
</script>

