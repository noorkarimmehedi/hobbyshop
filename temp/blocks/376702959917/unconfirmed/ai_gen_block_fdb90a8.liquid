    generate a category section where in mobile version every row will have 3 categories and should add image option also the category card size should be adjustable , change these to: Border
    Border width
    
    1
    Border color
    
    #E0E0E0
    Hover border color
    
    #CCCCCC
    Border radius
    
    8
    Shadow
    Horizontal offset
    
    0
    Vertical offset
    
    4
    Blur radius
    
    8
    Shadow opacity
    
    0
    , i should have the option to add collections directly from shopify , should have the option for the collection name text on overlay text or below the image. i want both option
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-category-grid-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-category-grid__container-{{ ai_gen_id }} {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-category-grid__heading-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: 32px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-category-grid__items-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.gap_mobile }}px;
  }

  .ai-category-card-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    background-color: {{ block.settings.card_background }};
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    box-shadow: {{ block.settings.shadow_horizontal }}px {{ block.settings.shadow_vertical }}px {{ block.settings.shadow_blur }}px rgba(0, 0, 0, {{ block.settings.shadow_opacity | divided_by: 100.0 }});
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .ai-category-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    border-color: {{ block.settings.hover_border_color }};
  }

  .ai-category-card__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: {{ block.settings.image_aspect_ratio }}%;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-category-card__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-category-card__placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-category-card__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-category-card__overlay-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: {{ block.settings.card_padding }}px;
    background: linear-gradient(to top, rgba(0, 0, 0, {{ block.settings.overlay_opacity | divided_by: 100.0 }}), transparent);
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-category-card__overlay-title-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.overlay_title_color }};
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
  }

  .ai-category-card__overlay-description-{{ ai_gen_id }} {
    margin: 8px 0 0;
    color: {{ block.settings.overlay_description_color }};
    font-size: {{ block.settings.description_size }}px;
    line-height: 1.4;
  }

  .ai-category-card__overlay-count-{{ ai_gen_id }} {
    margin: 4px 0 0;
    color: {{ block.settings.overlay_description_color }};
    font-size: {{ block.settings.description_size }}px;
    opacity: 0.9;
  }

  .ai-category-card__content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-category-card__title-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
  }

  .ai-category-card__description-{{ ai_gen_id }} {
    margin: 8px 0 0;
    color: {{ block.settings.description_color }};
    font-size: {{ block.settings.description_size }}px;
    line-height: 1.4;
  }

  .ai-category-card__count-{{ ai_gen_id }} {
    margin: 4px 0 0;
    color: {{ block.settings.description_color }};
    font-size: {{ block.settings.description_size }}px;
    opacity: 0.8;
  }

  @media screen and (min-width: 750px) {
    .ai-category-grid__items-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
      gap: {{ block.settings.gap_desktop }}px;
    }
  }
{% endstyle %}

<div class="ai-category-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-category-grid__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-category-grid__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-category-grid__items-{{ ai_gen_id }}">
      {% for i in (1..9) %}
        {% liquid
          assign collection_key = 'collection_' | append: i
          assign custom_title_key = 'collection_' | append: i | append: '_custom_title'
          assign custom_description_key = 'collection_' | append: i | append: '_custom_description'
          assign custom_image_key = 'collection_' | append: i | append: '_custom_image'

          assign collection = block.settings[collection_key]
          assign custom_title = block.settings[custom_title_key]
          assign custom_description = block.settings[custom_description_key]
          assign custom_image = block.settings[custom_image_key]
        %}

        {% if collection != blank %}
          {% liquid
            if custom_title != blank
              assign display_title = custom_title
            else
              assign display_title = collection.title
            endif

            if custom_description != blank
              assign display_description = custom_description
            else
              assign display_description = collection.description
            endif

            if custom_image != blank
              assign display_image = custom_image
            else
              assign display_image = collection.featured_image
            endif
          %}

          <a
            href="{{ collection.url }}"
            class="ai-category-card-{{ ai_gen_id }}"
          >
            <div class="ai-category-card__image-wrapper-{{ ai_gen_id }}">
              {% if display_image %}
                <img
                  src="{{ display_image | image_url: width: 600 }}"
                  alt="{{ display_image.alt | escape }}"
                  class="ai-category-card__image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="600"
                  height="{{ 600 | times: block.settings.image_aspect_ratio | divided_by: 100 }}"
                >
              {% else %}
                <div class="ai-category-card__placeholder-{{ ai_gen_id }}">
                  {{ 'collection-1' | placeholder_svg_tag }}
                </div>
              {% endif %}

              {% if block.settings.text_position == 'overlay' %}
                <div class="ai-category-card__overlay-{{ ai_gen_id }}">
                  {% if display_title != blank %}
                    <h3 class="ai-category-card__overlay-title-{{ ai_gen_id }}">{{ display_title }}</h3>
                  {% endif %}

                  {% if display_description != blank %}
                    <p class="ai-category-card__overlay-description-{{ ai_gen_id }}">{{ display_description }}</p>
                  {% endif %}

                  {% if block.settings.show_product_count %}
                    <p class="ai-category-card__overlay-count-{{ ai_gen_id }}">{{ collection.products_count }} products</p>
                  {% endif %}
                </div>
              {% endif %}
            </div>

            {% if block.settings.text_position == 'below' %}
              <div class="ai-category-card__content-{{ ai_gen_id }}">
                {% if display_title != blank %}
                  <h3 class="ai-category-card__title-{{ ai_gen_id }}">{{ display_title }}</h3>
                {% endif %}

                {% if display_description != blank %}
                  <p class="ai-category-card__description-{{ ai_gen_id }}">{{ display_description }}</p>
                {% endif %}

                {% if block.settings.show_product_count %}
                  <p class="ai-category-card__count-{{ ai_gen_id }}">{{ collection.products_count }} products</p>
                {% endif %}
              </div>
            {% endif %}
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

