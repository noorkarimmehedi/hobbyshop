  @prompt
    generate a category section where in mobile version every row will have 3 categories and should add image option also the category card size should be adjustable , change these to: Border
    Border width
    
    1
    Border color
    
    #E0E0E0
    Hover border color
    
    #CCCCCC
    Border radius
    
    8
    Shadow
    Horizontal offset
    
    0
    Vertical offset
    
    4
    Blur radius
    
    8
    Shadow opacity
    
    0
    , i should have the option to add collections directly from shopify , should have the option for the collection name text on overlay text or below the image. i want both option
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-category-grid-{{ ai_gen_id }} {
    padding: 40px 20px;
    background-color: {{ block.settings.section_background }};
  }

  .ai-category-grid__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-category-grid__heading-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: 30px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-category-grid__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-category-card-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    transition: all 0.3s ease;
    box-shadow: {{ block.settings.shadow_horizontal }}px {{ block.settings.shadow_vertical }}px {{ block.settings.shadow_blur }}px rgba(0, 0, 0, {{ block.settings.shadow_opacity | divided_by: 100.0 }});
  }

  .ai-category-card-{{ ai_gen_id }}:hover {
    border-color: {{ block.settings.hover_border_color }};
  }

  .ai-category-card__link-{{ ai_gen_id }} {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .ai-category-card__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: {{ block.settings.card_aspect_ratio }}%;
    overflow: hidden;
  }

  .ai-category-card__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-category-card__placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-category-card__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-category-card__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, {{ block.settings.overlay_opacity | divided_by: 100.0 }}) 100%);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 20px;
  }

  .ai-category-card__title-overlay-{{ ai_gen_id }} {
    color: {{ block.settings.overlay_text_color }};
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    text-align: center;
    margin: 0;
  }

  .ai-category-card__title-below-{{ ai_gen_id }} {
    padding: 15px;
    text-align: center;
    background-color: {{ block.settings.card_background }};
  }

  .ai-category-card__title-text-{{ ai_gen_id }} {
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-category-grid__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(3, 1fr);
      gap: {{ block.settings.grid_gap_mobile }}px;
    }

    .ai-category-grid__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-category-card__title-overlay-{{ ai_gen_id }},
    .ai-category-card__title-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="ai-category-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-category-grid__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-category-grid__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-category-grid__grid-{{ ai_gen_id }}">
      {% for i in (1..12) %}
        {% liquid
          assign collection_key = 'collection_' | append: i
          assign collection = block.settings[collection_key]
        %}

        {% if collection != blank %}
          <div class="ai-category-card-{{ ai_gen_id }}">
            <a href="{{ collection.url }}" class="ai-category-card__link-{{ ai_gen_id }}">
              <div class="ai-category-card__image-wrapper-{{ ai_gen_id }}">
                {% if collection.featured_image %}
                  <img
                    src="{{ collection.featured_image | image_url: width: 600 }}"
                    alt="{{ collection.featured_image.alt | escape }}"
                    class="ai-category-card__image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="600"
                    height="{{ 600 | times: block.settings.card_aspect_ratio | divided_by: 100 }}"
                  >
                {% else %}
                  <div class="ai-category-card__placeholder-{{ ai_gen_id }}">
                    {{ 'collection-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}

                {% if block.settings.title_position == 'overlay' %}
                  <div class="ai-category-card__overlay-{{ ai_gen_id }}">
                    <h3 class="ai-category-card__title-overlay-{{ ai_gen_id }}">
                      {{ collection.title }}
                    </h3>
                  </div>
                {% endif %}
              </div>

              {% if block.settings.title_position == 'below' %}
                <div class="ai-category-card__title-below-{{ ai_gen_id }}">
                  <h3 class="ai-category-card__title-text-{{ ai_gen_id }}">
                    {{ collection.title }}
                  </h3>
                </div>
              {% endif %}
            </a>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

